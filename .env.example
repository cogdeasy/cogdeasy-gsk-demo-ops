# Copy to .env (git-ignored) and fill in, or export in your shell. Every secret is read from the
# environment only; nothing is stored in code or config. Each CLI fails fast, naming every
# missing variable, and --dry-run needs none of these except GSK_AUDIT_PLAYBOOK_ID.
# Load with:  set -a; . ./.env; set +a

# Jira: demo-ops-seed, demo-ops-support-sim --target jira
JIRA_BASE_URL=https://cog-gtm.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=GSK

# Slack: demo-ops-support-sim --target slack (incoming webhook; the URL is a secret)
SLACK_WEBHOOK_URL=

# Devin automation Webhook trigger: demo-ops-oncall-sim
DEVIN_ONCALL_WEBHOOK_URL=
DEVIN_ONCALL_WEBHOOK_SECRET=

# Devin API v3: demo-ops-audit-pack (api/start_audit_pack.sh)
DEVIN_API_KEY=
DEVIN_ORG_ID=
GSK_AUDIT_PLAYBOOK_ID=
# DEVIN_API_URL=https://api.devin.ai

# Checkout holding the JSON data; only needed for a non-editable install.
# DEMO_OPS_ROOT=/path/to/cogdeasy-gsk-demo-ops
