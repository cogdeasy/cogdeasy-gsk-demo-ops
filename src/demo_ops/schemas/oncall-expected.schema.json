{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oncall-expected.schema.json",
  "title": "On-call answer key (never posted)",
  "type": "object",
  "required": ["expected"],
  "additionalProperties": false,
  "properties": {
    "note": {"type": "string"},
    "expected": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "classification", "action", "evidence", "output", "human_gate"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^A[0-9]+$"},
          "classification": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "output": {"type": "string", "minLength": 1},
          "human_gate": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
